# Dockerfile.fullstack
# Imagen todo-en-uno (Frontend Vue 3 compilado + Backend Express TypeScript)
# Ideal para desplegar en Azure App Service, AWS App Runner, Railway, Render o Fly.io

# Paso 1: Compilar Frontend Vue 3 + TypeScript
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json frontend/tsconfig*.json frontend/vite.config.ts frontend/index.html ./
RUN npm ci
COPY frontend/src ./src
RUN npm run build

# Paso 2: Compilar Backend Express + TypeScript
FROM node:20-alpine AS backend-builder
WORKDIR /app/backend
COPY backend/package*.json backend/tsconfig.json ./
RUN npm ci
COPY backend/src ./src
RUN npm run build

# Paso 3: Imagen Final de Producción
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=5000

# Dependencias de producción del backend
COPY backend/package*.json ./
RUN npm ci --only=production

# Copiar artefactos compilados
COPY --from=backend-builder /app/backend/dist ./dist
COPY --from=frontend-builder /app/frontend/dist ./public

EXPOSE 5000

CMD ["node", "dist/server.js"]
