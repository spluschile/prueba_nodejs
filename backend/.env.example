# Servidor Backend Express
PORT=5000
NODE_ENV=development

# Conexión a Base de Datos SQL Server
# Para localhost:
DB_SERVER=localhost
DB_PORT=1433
DB_USER=cloud_user
DB_PASSWORD=CloudPass123!*
DB_NAME=CloudTestDb

# Opciones de cifrado SSL/TLS (crucial para Azure SQL y AWS RDS)
# Para Azure SQL Database: DB_ENCRYPT=true, DB_TRUST_SERVER_CERTIFICATE=false
# Para Docker / Localhost / Dev: DB_ENCRYPT=false, DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Cadena de conexión alternativa (opcional si se usa en lugar de parámetros individuales)
# DATABASE_URL=Server=localhost,1433;Database=CloudTestDb;User Id=cloud_user;Password=CloudPass123!*;Encrypt=false;TrustServerCertificate=true;
