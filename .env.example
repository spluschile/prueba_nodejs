# =========================================================
# Variables de Entorno para Pruebas de Despliegue en la Nube
# =========================================================

# Puerto del Servidor API Express
PORT=5000
NODE_ENV=development

# Conexión a Base de Datos Microsoft SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_USER=cloud_user
DB_PASSWORD=TuPasswordSeguro123!*
DB_NAME=CloudTestDb

# Configuración SSL / TLS para la Nube
# Para Azure SQL Database:
#   DB_ENCRYPT=true
#   DB_TRUST_SERVER_CERTIFICATE=false
# Para Docker / Localhost / Dev:
#   DB_ENCRYPT=false
#   DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
